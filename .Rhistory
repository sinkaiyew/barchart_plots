library(readxl)
library(tidyverse)
library(scales)
library(stringr)
library(ggtext)
library(cowplot)
library(grid)
library(png)
old_wd <- "C:/Users/yewsi/OneDrive/Desktop/experiment"
setwd(old_wd)
Names_2010Census_Top1000 <- read_excel("Names_2010Census_Top1000.xlsx", skip = 2)
fix_names <- c("Dejesus" = "De Jesus",
"Delacruz" = "De La Cruz",
"Delarosa" = "De La Rosa",
"Deleon" = "DeLeon",
"Macdonald" = "MacDonald",
"Mcbride" = "McBride",
"Mccall" = "McCall",
"Mccann" = "McCann",
"Mccarthy" = "McCarthy",
"Mccarty" = "McCarty",
"Mcclain" = "McClain",
"Mcclure" = "McClure",
"Mcconnell" = "McConnell",
"Mccormick" = "McCormick",
"Mccoy" = "McCoy",
"Mccullough" = "McCullough",
"Mcdaniel" = "McDaniel",
"Mcdonald" = "McDonald",
"Mcdowell" = "McDowell",
"Mcfarland" = "McFarland",
"Mcgee" = "McGee",
"Mcguire" = "McGuire",
"Mcintosh" = "McIntosh",
"Mcintyre" = "McIntyre",
"Mckay" = "McKay",
"Mckee" = "McKee",
"Mckenzie" = "McKenzie",
"Mckinney" = "McKinney",
"Mclaughlin" = "McLaughlin",
"Mclean" = "McLean",
"Mcmahon" = "McMahon",
"Mcmillan" = "McMillan",
"Mcpherson" = "McPherson",
"Obrien" = "O'Brien",
"Oconnell" = "O'Connell",
"Oconnor" = "O'Connor",
"Odonnell" = "O'Donnell",
"Oneal" = "O'Neal",
"Oneill" = "O'Neill"
)
names_analysis <- Names_2010Census_Top1000 |>
slice(-(1001:1003)) |>
select(-`PROPORTION PER 100,000 POPULATION`, -`CUMULATIVE PROPORTION`) |>
rename(surname = SURNAME,
rank = RANK,
n = `FREQUENCY (COUNT)`,
white = `PERCENT NON-HISPANIC OR LATINO WHITE ALONE`,
black = `PERCENT NON-HISPANIC OR LATINO BLACK OR AFRICAN AMERICAN ALONE`,
asian_others = `PERCENT NON-HISPANIC OR LATINO ASIAN AND NATIVE HAWAIIAN AND OTHER PACIFIC ISLANDER ALONE`,
native_indian = `PERCENT NON-HISPANIC OR LATINO AMERICAN INDIAN AND ALASKA NATIVE ALONE`,
mixed = `PERCENT NON-HISPANIC OR LATINO TWO OR MORE RACES`,
hispanic_latino = `PERCENT HISPANIC OR LATINO ORIGIN`
) |>
mutate(black = suppressWarnings(as.numeric(black)),
native_indian = suppressWarnings(as.numeric(native_indian)),
surname = str_to_sentence(surname),
surname = recode(surname, !!!fix_names),
across(everything(), ~ replace_na(.x, 0))
) |>
mutate(num_char = nchar(surname),
alphabetical_rank = rank(surname),
first_alphabet = substr(surname, 1, 1))
names_analysis |>
ggplot(aes(x = as.numeric(factor(first_alphabet, levels = LETTERS)))) +
geom_col(aes(y = n/sum(n))) +
geom_density() +
scale_x_continuous(breaks = 1:26, labels = LETTERS) +
labs(y = "Randomization probability and density",
x = "First letter of names")
#change dataset interval if needed
real_candidate <- "^(Dan|Mc|Helen|Fou|Greg|Steve|Joe|Shek|Aar|Guc|Ela|Pel|Rob|Rai)"
names_interval <- names_analysis |>
slice(1:1000) |>
filter(!str_detect(surname, regex(real_candidate, ignore_case = TRUE)))
