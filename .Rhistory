my_plot_binned <- function(data, x, y, bins) {
ggplot(data, aes(x = {{ x }}, y = {{ y }})) +
geom_point() +
stat_summary_bin(bins = bins,
fun = mean,
geom = "line")
}
my_plot_binned(names_analysis, alphabetical_rank, rank, 100)
my_plot_binned(names_analysis, alphabetical_rank, n, 100)
my_plot_binned(names_analysis, alphabetical_rank, num_char, 100)
my_plot_binned(names_analysis, alphabetical_rank, white, 100)
my_plot_binned(names_analysis, alphabetical_rank, black, 100)
my_plot_binned(names_analysis, alphabetical_rank, asian_others, 100)
my_plot_binned(names_analysis, alphabetical_rank, native_indian, 100)
my_plot_binned(names_analysis, alphabetical_rank, mixed, 100)
my_plot_binned(names_analysis, alphabetical_rank, hispanic_latino, 100)
cor(names_analysis[sapply(names_analysis, is.numeric)], method = "spearman")
my_plot_binned2 <- function(data, x, y) {
ggplot(data, aes(x = {{ x }}, y = {{ y }}, group = 1)) +
geom_jitter() +
stat_summary(fun = mean, geom = "line")
}
my_plot_binned2(names_analysis, first_alphabet, rank)
my_plot_binned2(names_analysis, first_alphabet, n)
my_plot_binned2(names_analysis, first_alphabet, num_char)
my_plot_binned2(names_analysis, first_alphabet, white)
my_plot_binned2(names_analysis, first_alphabet, black)
my_plot_binned2(names_analysis, first_alphabet, asian_others)
my_plot_binned2(names_analysis, first_alphabet, native_indian)
my_plot_binned2(names_analysis, first_alphabet, mixed)
my_plot_binned2(names_analysis, first_alphabet, hispanic_latino)
img_data <- readPNG("share_button.png")
img_plot <- rasterGrob(img_data, interpolate = TRUE)
title <- "Post-McKee Poll: Rhode Island\nGovernor Primary"
reference <- c(
"<span style='color:#D0D0D0;'>by:</span> <span style='color:#FFFFFF;'><strong>Jusolyn Flower</strong></span>, <span style='color:#FFFFFF;'><strong>Barbara Ron</strong></span>",
"<span style='color:#D0D0D0;'>3:35 PM EST, Wed February 4, 2026</span>"
)
paras <- c(
"PROVIDENCE, R.I. (<span style='color:#1a73e8;'><strong>WPRI</strong></span>) — Governor Dan McKee announced he dropped out
of the governor primary race in December, after the dismal view of his job
performance jeopardized his re-election bid. Only 21% of Rhode Island residents
approve of his job performance, while nearly three-fourths disapprove.",
"With the race now wide open, the latest <span style='color:#1a73e8;'><strong>Ocean State Poll</strong></span>, released on January
30 by the University of New Hampshire Survey Center, reports favorability ratings
for the prospective candidates across parties."
)
reference_final <- paste(reference, collapse = "\n\n")
reference_final <- gsub("\n", "<br>", reference_final)
body <- paste(paras, collapse = "\n\n")
body <- gsub("\n", "<br>", body)
article <- ggplot() +
ylim(-5, 10) +
annotate(
"rect",
xmin = -Inf, xmax = Inf,
ymin = 7.2, ymax = Inf,
fill = "#1f1f1f",
color = NA
) +
annotate(
"text",
x = 0,
y = 10,
label = title,
size = 18,
fontface = "bold",
hjust = 0,
vjust = 1,
color = "#FFFFFF",
family = "serif"
) +
annotate(
"richtext",
label = reference_final,
x = 0,
y = 8.1,
size = 5,
hjust = 0,
vjust = 1,
fill = NA,
label.color = NA,
lineheight = 1,
family = "serif"
) +
annotation_custom(
img_plot,
xmin = 0, xmax = 4.6,
ymin = 5.1, ymax = 8.1) +
annotate(
"richtext",
x = 0,
y = 5.9,
label = body,
size = 7,
hjust = 0,
vjust = 1,
fill = NA,
label.color = NA,
lineheight = 1.9
) +
theme_void() +
scale_x_continuous(limits = c(0, 10),
expand = c(.0, 0))
