#change arguments
plot_number <- 30
plot_desc_order <- TRUE
number_candidate <- 5
number_candidate <- 5
empty_list <- vector("list", plot_number)
setwd("barchart_plots")
set.seed(1)
if(plot_desc_order) {
vote_count <- sort((runif(number_candidate, 0, 10000))^2, decreasing = TRUE)
vote_share <- vote_count / sum(vote_count)
rand_name <- sample(names_interval$surname, number_candidate, replace = FALSE)
} else {
vote_count <- (runif(number_candidate, 0, 10000))^2
vote_share <- vote_count / sum(vote_count)
rand_name <- sort(sample(names_interval$surname, number_candidate, replace = FALSE))
}
df <- tibble(candidate = as.character(1:number_candidate),
rand_name,
vote_count,
vote_share)
party_color <- sample(c("#0015BC", "#E81B23"), 1)
plot <- ggplot(df, aes(x = candidate, y = vote_share)) +
geom_col(
fill = party_color,
alpha = .5,
width = .85
) +
scale_y_continuous(
breaks = seq(0, .6, .1),
labels = scales::percent,
expand = c(.02, 0)
) +
scale_x_discrete(
limits = rev,
labels = setNames(rand_name, as.character(1: number_candidate))
) +
labs(
title = ifelse(party_color == "#0015BC",
"2026 Rhode Island Governor: Democratic Primary",
"2026 Rhode Island Governor: Republican Primary"),
x = NULL,
y = "PERCENT",
caption = "Source: UNH Survey Center. Survey conducted Jan. 19-23, 2026",
subtitle = "CANDIDATES"
) +
theme(
plot.title = element_text(size = 23,
face = "bold",
hjust = .05,
margin = margin(b = 25),
family = "serif"),
plot.subtitle = element_text(size = 11,
face = "bold",
hjust = .03),
panel.background = element_blank(),
panel.grid = element_blank(),
axis.text.x = element_text(size = 12),
axis.title.x = element_text(size = 11,
face = "bold",
margin = margin(t = 8)),
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
plot.caption = element_text(size = 11)
) +
coord_flip(
ylim = c(0, .6)
) +
geom_vline(
xintercept = seq(.5, 5.5, by = 1),
color = "black",
linewidth = .1,
alpha = .3
) +
geom_text(
aes(label = rand_name),
y = 0.005,
color = "black",
fontface = "bold",
size = 7,
hjust = 0,
family = "serif"
)
combined_plots <- ggdraw() +
draw_plot(
plot = article,
x = 0,
y = 0,
width = 1,
height = 1,
scale = 1,
hjust = 0,
vjust = 0,
halign = 0.5,
valign = 0.5
) +
draw_plot(
plot = plot,
x = 0,
y = -0.02,
width = 1,
height = 0.45,
scale = .9,
hjust = 0,
vjust = 0,
halign = 0.5,
valign = 0.5
)
plot
combined_plots
