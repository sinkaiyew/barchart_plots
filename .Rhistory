labs(
title = "2026 Rhode Island Governor",
x = NULL,
y = "PERCENT",
caption = "Source: UNH Survey Center. Survey conducted Jan. 19-23, 2026",
subtitle = "CANDIDATES"
) +
theme(
plot.title = element_text(size = 23,
face = "bold",
hjust = .05,
margin = margin(b = 25),
family = "serif"),
plot.subtitle = element_text(size = 11,
face = "bold",
hjust = .03),
panel.background = element_blank(),
panel.grid = element_blank(),
axis.text.x = element_text(size = 12),
axis.title.x = element_text(size = 11,
face = "bold",
margin = margin(t = 8)),
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
plot.caption = element_text(size = 11)
) +
coord_flip(
ylim = c(0, .6)
) +
geom_vline(
xintercept = seq(.5, 5.5, by = 1),
color = "black",
linewidth = .1,
alpha = .3
) +
geom_text(
aes(label = rand_name),
y = 0.005,
color = "black",
fontface = "bold",
size = 7,
hjust = 0,
family = "serif"
) +
annotate(
"segment",
x = 5, xend = 3.5,
y = .1, yend = .35,
arrow = arrow(length = unit(.6, "cm")),
linewidth = 1.25
) +
annotate(
"segment",
x = 4, xend = 3.25,
y = .1, yend = .35,
arrow = arrow(length = unit(.6, "cm")),
linewidth = 1.25
)+
annotate(
"segment",
x = 3, xend = 3,
y = .1, yend = .35,
arrow = arrow(length = unit(.6, "cm")),
linewidth = 1.25
)+
annotate(
"segment",
x = 2, xend = 2.75,
y = .1, yend = .35,
arrow = arrow(length = unit(.6, "cm")),
linewidth = 1.25
)+
annotate(
"segment",
x = 1, xend = 2.5,
y = .1, yend = .35,
arrow = arrow(length = unit(.6, "cm")),
linewidth = 1.25
) +
annotate(
"rect",
xmin = 2, xmax = 4,
ymin = .37, ymax = .59,
fill = "gray",
color = "black "
) +
annotate(
"text",
x = 3, y = .48,
label = "Select the\ncandidates you\nsaw in the\n earlier chart",
size = 11,
fontface = "bold"
)
